# Qwen3.8-Max open-weight base in official FP8 precision.
MODEL_ID="Qwen/Qwen3.8-2.4T-A95B-FP8"
TRUST_REMOTE_CODE="0"
DTYPE="bfloat16"
BATCH_SIZE="1"
EXTRACT_POSITIONS="1"

# This intentionally exceeds a normal 8x B300 Pod. The profile is usable only
# on a single host with enough aggregate memory; it must not silently spill a
# multi-terabyte model to slow network storage.
MIN_TOTAL_VRAM_GIB="2700"
MIN_DISK_GIB="2700"
OUTPUT_PATH="/workspace/ablate-output/qwen38-fp8-directions.pt"
